<Window x:Class="ChatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ChatApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="680" Width="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="200"/>
            <ColumnDefinition Width="7*" MinWidth="300"/>
        </Grid.ColumnDefinitions>

        <Grid>
            <StackPanel>
                <GroupBox Header="Server" Margin="0,5">
                    <StackPanel>
                        <Label Content="Server name"  />
                        <TextBox Margin="5,0,5,0" Text="{Binding ServerName, UpdateSourceTrigger=PropertyChanged}" />
                        <Label Content="Listen to port" Margin="5,0,5,0" />
                        <TextBox Margin="5,0,5,0" Text="{Binding ListeningPort, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Start Listening" Margin="5,10,5,0" Command="{Binding StartListeningCommand}" />
                        <Button Content="Stop Listening" Margin="5,10,5,0" Command="{Binding StopListeningCommand}"/>

                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Client" Margin="0,5">
                    <StackPanel>
                        <Label Content="Client name"  />
                        <TextBox Margin="5,0,5,0" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}"/>
                        <Label Content="Connect to IP-adress" Margin="5,0,5,0" />
                        <TextBox Margin="5,0,5,0" Text="{Binding ConnectIP, UpdateSourceTrigger=PropertyChanged}"/>

                        <Label Content="Connect to port" Margin="5,0,5,0" />
                        <TextBox Margin="5,0,5,0" Text="{Binding ConnectPort, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Content="Connect" Margin="5,10,5,0" Command="{Binding ConnectCommand}"/>
                        <Button Content="Disconnect" Margin="5,10,5,0" Command="{Binding DisconnectCommand}"/>
                    </StackPanel>
                </GroupBox>
                
                <GroupBox Header="History" Margin="0,5">
                    <StackPanel>
                        <Label Content="Search" Margin="5,0,5,0" />
                        <TextBox Margin="5,0,5,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <DataGrid CanUserAddRows="False" CanUserDeleteRows="False" Margin="0,10,0,5" Height="120" MaxHeight="120"
                                  ItemsSource="{Binding SelectedHistory}" SelectedItem="{Binding SelectedHistoryTab}" 
                                  SelectionMode="Single" AutoGenerateColumns="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" />
                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="7*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Show" Margin="5,5,5,0" Command="{Binding ViewChattCommand}" />
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </Grid>

        <GroupBox Header="Chat" Grid.Column="1">
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListView ItemsSource="{Binding Messages}" />

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox HorizontalAlignment="Stretch" Height="25" FontSize="14" Text="{Binding Message}" />
                    <StackPanel Orientation="Horizontal" Grid.Column="1">
                        <Button  Content="Send" Width="50" Command="{Binding SendCommand}"/>
                        <Button  Content="Buzz" Width="50" Command="{Binding BuzzCommand}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
